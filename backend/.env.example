# Copy to .env — NEVER commit a real .env. No real secrets are in this file.
PORT=4000
NODE_ENV=development
# If set, the API uses PostgreSQL (Supabase). If unset, it uses an in-memory
# store seeded with demo data — fine for local smoke tests, NOT for production.
DATABASE_URL=
# Required in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Comma-separated allowed origins, e.g. https://your-frontend.pages.dev,http://localhost:8000
CORS_ORIGIN=http://localhost:8000,http://localhost:5173
# Demo accounts are seeded only when SEED_DEMO=true (default true in dev).
SEED_DEMO=true
# Optional: if set, creating an admin via /api/auth/register requires this key
# in header x-admin-setup-key. Leave unset to disable admin self-registration.
ADMIN_SETUP_KEY=
